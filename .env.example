# Base URL of the Integration API (no trailing slash).
TARGET_URL=http://localhost:3000
# API key sent as X-API-Key. It stays on the server and never reaches the browser.
# On a public deployment use a key scoped to the demo account 478 (see docs/DEPLOY.md).
TARGET_API_KEY=test-key-local
# Port of this sender.
PORT=4000
# true lets the UI and API change the target URL or key per request. Default false.
ALLOW_TARGET_OVERRIDE=false
# Hosts an override URL may use, comma separated. Each host must also resolve to a public IP.
TARGET_ALLOWLIST=
# Timeout for each request to the target, in ms.
REQUEST_TIMEOUT_MS=15000
# Sends per client IP per minute, and in total per minute, on /api/send.
SEND_RATE_PER_MINUTE=10
SEND_RATE_PER_MINUTE_GLOBAL=60
# true reads the client IP from X-Forwarded-For (only behind a proxy that sets it, such as Render).
TRUST_PROXY=false
