# Base URL of the Integration API (no trailing slash).
TARGET_URL=http://localhost:3000
# API key sent as X-API-Key. It stays on the server and never reaches the browser.
TARGET_API_KEY=test-key-local
# Port of this sender.
PORT=4000
# Set to false to stop the UI and API from changing the target URL or key.
ALLOW_TARGET_OVERRIDE=true
# Timeout for each request to the target, in ms.
REQUEST_TIMEOUT_MS=15000
