TARGET_URL=http://localhost:3000
# On a public deployment use a key scoped to account 478.
TARGET_API_KEY=test-key-local
PORT=4000
ALLOW_TARGET_OVERRIDE=false
# Each host must also resolve to a public IP.
TARGET_ALLOWLIST=
REQUEST_TIMEOUT_MS=15000
SEND_RATE_PER_MINUTE=10
SEND_RATE_PER_MINUTE_GLOBAL=60
# Only behind a proxy that sets X-Forwarded-For, such as Render.
TRUST_PROXY=false
